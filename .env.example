# Gurost — environment variables
# Regenerated by grepping every real process.env.* reference in the
# actual current codebase (69 direct matches, 2 excluded as false
# positives from an illustrative code comment, 5 WhatsApp vars added
# back manually since that file accesses them via process.env[name]
# indirection, which a simple grep can't see — checked directly, not
# assumed). Every variable below corresponds to real, working code.

# ============================================================
# REQUIRED — the server will not start without these
# ============================================================
PORT=3000
JWT_SECRET=                         # any random string for local testing; use a real long random value in production
OMNIROUTE_API_KEY=                  # server refuses to start without this — every Claude call routes through here now

# ============================================================
# DATABASE — required for login, signup, and anything persistent.
# The server WILL start without these (lazy-initialized as of the
# startup-fix round), but auth, billing, and most bots will fail with
# a clear error the moment they're actually used.
# ============================================================
DATABASE_URL=                       # Postgres connection string
SUPABASE_URL=
# The SERVICE ROLE key (Settings > API > service_role in your Supabase
# dashboard) — NOT the anon/public key. A different, more privileged
# credential this backend needs to bypass row-level security. Using
# the anon key here is a real, common mistake that looks like it
# should work but won't.
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=                # Settings > API > JWT Secret — only needed for SSO (Ultimate tier)

# ============================================================
# AI — generation, chat, embeddings
# ============================================================
OMNIROUTE_BASE_URL=http://localhost:20128/v1
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
GPT56_MODEL=
OMNIROUTE_GEMINI_MODEL=
OMNIROUTE_DEEPSEEK_MODEL=
OPENAI_API_KEY=                     # separate from OmniRoute — used for embeddings (industry-rag.js) and real AI image generation (image-bot.js's GPT Image calls)
DEEPGRAM_API_KEY=                   # voice transcription
HEADROOM_PROXY_URL=                 # legacy — see README's orphaned-files note, likely unused

# ============================================================
# BILLING — Stripe (Gurost's OWN platform account, real subscriptions)
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_UNLIMITED=
STRIPE_PRICE_ULTIMATE=
STRIPE_PRICE_TOPUP_50=
STRIPE_PRICE_TOPUP_100=
STRIPE_PRICE_TOPUP_250=
STRIPE_PRICE_BUSINESS_ASSISTANT_BASE=
STRIPE_PRICE_BUSINESS_ASSISTANT_BOT=
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
# NOTE: "Sell This For Me"'s checkout-link generation uses a DIFFERENT
# key, supplied by each user per-request for their OWN Stripe account —
# never stored, never this env var.

# ============================================================
# EMAIL — Postmark (real; required for password reset to work,
# lazy-initialized as of the startup-fix round so its absence won't
# crash the server, only email-sending features)
# ============================================================
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=                # must be a verified sender in your Postmark account

# ============================================================
# WHATSAPP CLOUD API (Meta)
# ============================================================
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=                # required for real webhook signature verification — not optional
WHATSAPP_BUSINESS_ACCOUNT_ID=       # not read by any shipped code yet; kept for template management later

# ============================================================
# MEETING CO-PILOT / VIDEO — LiveKit (real, never tested against a
# live server — see README's Known Limitations)
# ============================================================
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ============================================================
# IMAGES — real stock photo search
# ============================================================
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
IMAGE_PROVIDER_ORDER=unsplash,pexels,pixabay

# ============================================================
# ADMIN
# ============================================================
ADMIN_EMAILS=                       # comma-separated, case-insensitive — see README's admin.html section for how this actually works (no DB role field)
SWARM_ADMIN_USER_ID=

# ============================================================
# DEPLOYMENT — for USER-GENERATED apps, not Gurost's own backend
# ============================================================
RENDER_API_KEY=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
GITHUB_TOKEN=
NEON_API_KEY=
NEON_ORG_ID=

# ============================================================
# ANDROID BUILD PIPELINE
# ============================================================
E2B_API_KEY=
E2B_ANDROID_TEMPLATE_ID=
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_ALIAS_PASSWORD=

# ============================================================
# NOTIFICATIONS
# ============================================================
NTFY_SERVER=
NTFY_TOKEN=

# ============================================================
# MISC / OPS
# ============================================================
FRONTEND_BASE_URL=http://localhost:3000
GUROST_REPO_ROOT=                   # absolute path to this repo, used by self-healing.js's verification sandbox
SESSION_TOKEN_EXPIRY=24h
TRUST_PROXY=                        # set to number of reverse-proxy hops in front of this server; leave unset for local/direct

# Rate limiting & security thresholds — real defaults exist in code;
# only set these if you want to override them.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=
USER_RATE_LIMIT_WINDOW_MS=
USER_RATE_LIMIT_MAX_REQUESTS=
SECURITY_VIOLATION_WINDOW_MINUTES=60
SECURITY_VIOLATION_BLOCK_THRESHOLD=5
COST_SPIKE_MULTIPLIER=
SWARM_HEARTBEAT_STALE_MINUTES=
SWARM_PROPOSAL_SPIKE_THRESHOLD=
CHECKPOINT_INTERVAL_MINUTES=
